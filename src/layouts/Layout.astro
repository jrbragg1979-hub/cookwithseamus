---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Meet Seamus, your personal AI chef. Get real-time cooking guidance, recipes, meal planning, and culinary education — all by voice, in 30+ languages.',
  ogImage = '/og-image.png',
} = Astro.props;

// Open Graph requires ABSOLUTE urls. A bare "/logo.png" happens to work —
// Facebook and Apple both resolve it against the page — but that is scraper
// leniency, not the spec, and not every platform is lenient. Astro.site is
// already set in astro.config.mjs, so resolving costs nothing and stops this
// depending on someone else's goodwill.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#3E2C20" />
  <link rel="icon" type="image/png" href="/logo.png" />

  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Cook with Seamus" />

  {/* X showed no preview at all before these. summary_large_image now that
      og-image.png is a proper 1200x630 card — rendered from the Remotion
      project so it uses the same brown, the same Eagle Lake and the same
      winking logo the videos close on. */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Eagle+Lake&family=Kalam:wght@400;700&family=Quicksand:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <slot />
</body>
</html>
