---
import Layout from '../layouts/Layout.astro';
import RecipeSearch from '../components/RecipeSearch.jsx';
---
<Layout title="Seamus — Your AI Kitchen Companion">

  <!-- Hero -->
  <div class="hero">
    <img src="/Seamus_Logo_Dark.png" alt="Seamus" class="hero-brand-mark" />
    <h1 class="hero-tagline-main">Ask Seamus. Cook anything.</h1>

    <RecipeSearch client:load />

    <p class="hero-free-note">Free forever — no sign-up needed to try</p>
  </div>

  <!-- Features -->
  <section id="features">
    <h2 class="section-title">What Seamus Does</h2>
    <p class="section-subtitle">A personalized recipe generator, a cookbook that grows with you, and a voice chef when you want one — all rolled into your pocket.</p>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-emoji">🔍</div>
        <h3 class="feature-title">Recipe Search</h3>
        <p class="feature-desc">Type anything you want to cook — a specific dish, a vague craving, or a single ingredient from your fridge. Seamus writes you a personalized recipe in five seconds. Vague requests get quick clarifying questions ("dessert or drink?"), then you're set.</p>
      </div>
      <div class="feature-card">
        <div class="feature-emoji">📖</div>
        <h3 class="feature-title">Save & Organize</h3>
        <p class="feature-desc">Every recipe you keep becomes a page in your Memories cookbook. Shopping lists auto-generate from the ingredients — one tap and you're ready for the store. Come back weeks later and it's all still there.</p>
      </div>
      <div class="feature-card">
        <div class="feature-emoji">📅</div>
        <h3 class="feature-title">Meal Planning</h3>
        <p class="feature-desc">Plan your week with Seamus. Drop recipes into your calendar, get an auto-combined shopping list for everything you need, and free up your Sunday-night "what are we eating this week" scramble.</p>
      </div>
      <div class="feature-card">
        <div class="feature-emoji">🗣</div>
        <h3 class="feature-title">Talk to Seamus</h3>
        <p class="feature-desc">When typing isn't enough — call Seamus for hands-free help while you cook. Ask "what does 'fold in the flour' mean?" mid-recipe. Get walked through techniques as you go. Warm Irish voice, always patient, never rushes you.</p>
      </div>
      <div class="feature-card">
        <div class="feature-emoji">🎓</div>
        <h3 class="feature-title">Culinary Academy</h3>
        <p class="feature-desc">Learn knife skills, sauces, techniques, and more through interactive lessons. Master the pinch grip, learn why brown butter tastes better, discover which knife does what — all at your own pace.</p>
      </div>
      <div class="feature-card">
        <div class="feature-emoji">🥗</div>
        <h3 class="feature-title">Dietary Care & 30+ Languages</h3>
        <p class="feature-desc">Vegan, kosher, halal, gluten-free, allergic to shellfish — set your preferences once and Seamus honors them absolutely. And he speaks your language — Spanish, French, Japanese, Hindi, Arabic, 25 more. Set it once, works everywhere.</p>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <div class="bottom-cta">
    <h2 class="section-title">Ready to Cook?</h2>
    <p>Get Seamus on your phone for the full experience — save recipes, plan meals, and call your Irish chef when you need him.</p>
    <div class="store-buttons">
      <a
        href="https://play.google.com/store/apps/details?id=com.synergyautomations.seamus"
        class="store-badge"
      >
        <img src="/badge-googleplay-en.svg" alt="Get it on Google Play" width="238" height="71" />
      </a>
    </div>
    <p class="store-note">Coming soon to the App Store</p>

    <!--
      When Apple approves the iOS build, replace the <p class="store-note"> above
      with this, placed BEFORE the Google Play link — Apple requires their badge
      to come first when another platform's badge is present:

      <a href="APP_STORE_URL" class="store-badge">
        <img src="/badge-appstore-en.svg" alt="Download on the App Store" width="240" height="80" />
      </a>

      The artwork is already in public/. Do not use Apple's badge until the app
      is actually downloadable — a badge that links nowhere is worse than a
      plain line of text.
    -->
  </div>


 

  <!-- Footer -->
  <footer>
    <div>
      <a href="/blog/">Blog</a>
      <a href="/support/">Support</a>
      <a href="https://seamus-app-production.up.railway.app/terms">Terms of Service</a>
      <a href="https://seamus-app-production.up.railway.app/privacy">Privacy Policy</a>
      <a href="https://seamus-app-production.up.railway.app/disclaimer">Food Disclaimer</a>
      <a href="mailto:synergyautomations79@gmail.com">Contact</a>
    </div>
    <p class="footer-company">&copy; 2026 Synergy Automations. All rights reserved.</p>
  </footer>

</Layout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 48px 24px 60px;
    background: linear-gradient(180deg, #3E2C20 0%, #5C3D2E 55%, #6B4F3A 85%, var(--bg) 100%);
    position: relative;
  }

  .hero-brand-mark {
    width: 176px;
    height: 176px;
    object-fit: cover;
    object-position: left center;
    border-radius: 50%;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    margin-bottom: 20px;
  }

  .hero-tagline-main {
    font-family: 'Eagle Lake', cursive;
    font-size: 2.2rem;
    color: #F0EBE3;
    margin: 0 0 36px;
    letter-spacing: 0.5px;
    line-height: 1.25;
    max-width: 620px;
  }

  .hero-free-note {
    color: rgba(240, 230, 211, 0.65);
    font-size: 0.88rem;
    font-style: italic;
    margin: 24px 0 0;
    letter-spacing: 0.3px;
  }

  section {
    padding: 80px 24px;
    max-width: 960px;
    margin: 0 auto;
  }

  .section-title {
    font-family: 'Eagle Lake', cursive;
    font-size: 1.8rem;
    color: var(--dark-wood);
    text-align: center;
    margin-bottom: 12px;
  }

  .section-subtitle {
    text-align: center;
    color: var(--muted);
    font-size: 1rem;
    margin-bottom: 48px;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .feature-card {
    background: var(--cream);
    border-radius: 16px;
    padding: 28px 24px;
    border: 1px solid var(--border);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .feature-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(62, 44, 32, 0.08);
  }

  .feature-emoji { font-size: 2rem; margin-bottom: 12px; }

  .feature-title {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--dark-wood);
    margin-bottom: 8px;
  }

  .feature-desc {
    font-family: 'Georgia', serif;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 560px;
    margin: 0 auto;
  }

  .step { display: flex; gap: 20px; align-items: flex-start; }

  .step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--copper);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .step-text h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--dark-wood);
    margin-bottom: 4px;
  }

  .step-text p {
    font-family: 'Georgia', serif;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .pricing-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 640px;
    margin: 0 auto;
  }

  .price-card {
    background: var(--cream);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px 28px;
    text-align: center;
    position: relative;
  }

  .price-card.featured {
    border-color: var(--copper);
    box-shadow: 0 8px 32px rgba(184, 115, 51, 0.15);
  }

  .price-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--copper);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 16px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .price-name {
    font-family: 'Eagle Lake', cursive;
    font-size: 1.3rem;
    color: var(--dark-wood);
    margin-bottom: 8px;
  }

  .price-amount {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--dark-wood);
    margin-bottom: 4px;
  }

  .price-amount span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
  }

  .price-period {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 20px;
  }

  .price-features { list-style: none; text-align: left; margin-bottom: 24px; }

  .price-features li {
    padding: 6px 0;
    font-size: 0.9rem;
    color: var(--wood);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .price-features li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--copper);
    flex-shrink: 0;
  }

  .price-cta {
    display: block;
    width: 100%;
    padding: 14px;
    border-radius: 12px;
    font-family: 'Quicksand', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s;
    border: none;
  }

  .price-cta-free {
    background: var(--linen);
    color: var(--wood);
    border: 1px solid var(--border);
  }

  .price-cta-free:hover { background: var(--border); }

  .price-cta-premium {
    background: linear-gradient(135deg, var(--copper), var(--gold));
    color: #fff;
    box-shadow: 0 4px 14px rgba(184, 115, 51, 0.25);
  }

  .price-cta-premium:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(184, 115, 51, 0.35);
  }

  .languages-section {
    background: var(--linen);
    border-radius: 20px;
    padding: 48px 32px;
    text-align: center;
    margin: 0 auto;
    max-width: 640px;
  }

  .lang-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  .lang-tag {
    padding: 6px 14px;
    border-radius: 20px;
    background: var(--cream);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--wood);
  }

  .install-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
    max-width: 380px;
    margin: 0 auto;
  }

  .install-step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .install-icon { font-size: 1.6rem; flex-shrink: 0; margin-top: 2px; }

  .install-step strong {
    font-size: 0.95rem;
    color: var(--dark-wood);
    display: block;
    margin-bottom: 2px;
  }

  .install-step p {
    font-family: 'Georgia', serif;
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }

  .bottom-cta {
    text-align: center;
    padding: 80px 24px;
    background: linear-gradient(180deg, var(--bg) 0%, var(--linen) 100%);
  }

  .bottom-cta .section-title { margin-bottom: 16px; }

  .bottom-cta p {
    color: var(--muted);
    margin-bottom: 32px;
    font-size: 1rem;
  }

  .store-buttons {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  /* Official store artwork only — both Apple and Google prohibit recreating
     their badges, which the previous emoji-and-text buttons did. The badge
     itself must not be restyled, recoloured or distorted, so the link is a
     bare wrapper and only the whole thing lifts on hover.
     Apple: https://toolbox.marketingtools.apple.com/app-store/
     Google: https://partnermarketinghub.withgoogle.com/brands/google-play/ */
  .store-badge {
    display: inline-flex;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .store-badge:hover {
    transform: translateY(-1px);
  }

  .store-badge img {
    height: 56px;
    width: auto;
    display: block;
  }

  .store-note {
    text-align: center;
    margin-top: 14px;
    color: var(--stone);
    font-size: 0.9rem;
  }


  footer {
    text-align: center;
    padding: 32px 24px;
    border-top: 1px solid var(--border);
    color: var(--stone);
    font-size: 0.8rem;
  }

  footer a {
    color: var(--muted);
    text-decoration: none;
    margin: 0 12px;
  }

  footer a:hover { color: var(--copper); }

  .footer-company {
    margin-top: 12px;
    font-size: 0.75rem;
    color: var(--stone);
  }

  @media (max-width: 600px) {
    .hero-tagline-main {
      font-size: 1.5rem;
      margin: 0 0 24px;
      max-width: 100%;
    }
    .hero-brand-mark { width: 132px; height: 132px; }
    .hero-free-note { font-size: 0.82rem; }
    section { padding: 60px 20px; }
    .section-title { font-size: 1.5rem; }
    .features-grid { grid-template-columns: 1fr; }
  }
</style>
